# Security and caching headers for Netlify and Cloudflare Pages (both read this file as-is).
# For another host, copy the same values into its configuration. See docs/DEPLOY.md.
#
# If you connect a form service, add its domain to connect-src and form-action below.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/vendor/*
  Cache-Control: public, max-age=2592000

/assets/site.css
  Cache-Control: public, max-age=3600, must-revalidate

/assets/main.js
  Cache-Control: public, max-age=3600, must-revalidate
